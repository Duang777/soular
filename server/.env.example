# ===== 公开配置（可以进代码包）=====

# 知乎开放平台分配的 App ID（纯数字）
ZHIHU_APP_ID=

# 授权完成后的回调地址：必须是公网 HTTPS，且以 /auth/callback 结尾。
# 本地 localhost 无法完成真实登录，留空时服务只预览页面、不发起授权。
# 示例：https://your-domain.example/auth/callback
ZHIHU_REDIRECT_URI=

# 允许调用 API 的前端 Origin，多个值用逗号分隔，不能包含路径。
FRONTEND_ORIGIN=https://soular.top,https://duang777.github.io

# OAuth 完成后返回的正式前端完整地址。
FRONTEND_URL=https://soular.top/

# 服务监听端口。平台（Cloudflare/Sealos/...）通常会注入 PORT。
PORT=8787

# ===== 密钥（只能放在后端 / 平台 Secret，切勿提交、切勿下发前端）=====

# OAuth App Key：向 product-platform@zhihu.com 申请，用于后端换取 access_token
ZHIHU_OAUTH_APP_KEY=

# 开放平台 Access Secret：developer.zhihu.com 个人中心生成，用于数据接口 Bearer 鉴权
ZHIHU_ACCESS_SECRET=
