{
  "name": "soular",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 4325",
    "build": "tsc -b && npm run check:navigation && vite build",
    "check:navigation": "node scripts/check-nebula-navigation.mjs",
    "preview": "vite preview --port 4325",
    "server:dev": "npm --prefix server run dev",
    "server:check": "npm --prefix server run check",
    "server:typecheck": "npm --prefix server run typecheck",
    "server:deploy": "npm --prefix server run deploy",
    "deploy": "npm run build && npm run server:check && npm run server:deploy"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
