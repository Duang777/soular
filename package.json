{
  "name": "soular",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 4325",
    "build": "tsc -b && npm run check:navigation && npm run check:share-match && npm run check:peer-discovery && npm run check:identity-revision && npm run check:lod && npm run check:personas && npm run check:preset-authors && vite build",
    "check:navigation": "node scripts/check-nebula-navigation.mjs",
    "check:share-match": "node scripts/check-share-match.mjs",
    "check:peer-discovery": "node scripts/check-peer-discovery.mjs",
    "check:identity-revision": "node --experimental-strip-types scripts/check-identity-revision.mjs",
    "check:lod": "node scripts/check-nebula-lod.mjs",
    "check:personas": "node scripts/check-persona-library.mjs",
    "check:preset-authors": "node scripts/check-preset-authors.mjs",
    "apply:preset-authors": "node scripts/apply-preset-authors.mjs",
    "preview": "vite preview --port 4325",
    "server:dev": "npm --prefix server run dev",
    "server:check": "npm --prefix server run check",
    "server:typecheck": "npm --prefix server run typecheck",
    "server:deploy": "npm --prefix server run deploy",
    "deploy": "npm run build && npm run server:check && npm run server:deploy"
  },
  "dependencies": {
    "@designcodeio/threeui": "^1.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.18.3",
    "three": "^0.160.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
